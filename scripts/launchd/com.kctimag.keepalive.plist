<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kctimag.keepalive</string>

  <!-- 발행/메일과 무관: Supabase 무료 플랜 자동 일시정지 방지용 가벼운 핑 -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/Users/jinjin/kctimag/scripts/keepalive.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/jinjin/kctimag</string>

  <!-- 매 2시간(하루 12회) — "하루 몇 건" 기준을 여유 있게 상회. 쿼리 1건짜리 핑이라 부하 무시 가능 -->
  <key>StartInterval</key>
  <integer>7200</integer>

  <!-- 로그인/재부팅 직후에도 1회 즉시 실행 -->
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/jinjin/kctimag/.pipeline-tmp/keepalive.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jinjin/kctimag/.pipeline-tmp/keepalive.log</string>
</dict>
</plist>
