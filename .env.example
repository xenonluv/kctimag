# 이 파일은 커밋됨 — 실제 키 절대 넣지 말 것. .env.local 을 만들어 값 채우기.

# Naver 검색 API (https://developers.naver.com) — 뉴스 수집
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Google Gemini API (https://aistudio.google.com/apikey) — AI 개념 이미지 생성(무료)
GOOGLE_GEMINI_API_KEY=

# Pexels API (https://www.pexels.com/api) — 스톡 이미지(무료)
PEXELS_API_KEY=

# 메일 발송: MAIL_PROVIDER = brevo(기본, 무료·무도메인) | resend(도메인 보유 시)
MAIL_PROVIDER=brevo
MAIL_FROM="KCT <your@email.com>"
# Brevo (https://app.brevo.com/settings/keys/api) — API 키(xkeysib-...) + 단일발신자 인증 필요
BREVO_API_KEY=
# Resend (https://resend.com) — 도메인 인증 보유 시
RESEND_API_KEY=
RESEND_FROM="KCT <news@yourdomain.com>"

# Supabase (https://supabase.com) — 구독자 DB + Auth + Storage(무료)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 배포된 사이트 URL (메일 링크/메타데이터용)
NEXT_PUBLIC_SITE_URL=https://kctimag.vercel.app

# 관리자 모드 (비밀번호 + 세션 시크릿)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Claude CLI 실행 경로 (기본: claude). claude -p 헤드리스 사용, 별도 키 불필요.
CLAUDE_BIN=claude
# CLAUDE_MODEL=sonnet   # 파이프라인 LLM 모델(옵션). 비우면 기본 모델.
