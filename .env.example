# 이 파일은 커밋됨 — 실제 키 절대 넣지 말 것. .env.local 을 만들어 값 채우기.

# Naver 검색 API (https://developers.naver.com) — 뉴스 수집
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Google Gemini API (https://aistudio.google.com/apikey) — AI 개념 이미지 생성(무료)
GOOGLE_GEMINI_API_KEY=

# Pexels API (https://www.pexels.com/api) — 스톡 이미지(무료)
PEXELS_API_KEY=

# 메일 발송: MAIL_PROVIDER = brevo(기본, 무료·무도메인) | resend(도메인 보유 시)
MAIL_PROVIDER=brevo
MAIL_FROM="KCT <your@email.com>"
# Brevo (https://app.brevo.com/settings/keys/api) — API 키(xkeysib-...) + 단일발신자 인증 필요
BREVO_API_KEY=
# Resend (https://resend.com) — 도메인 인증 보유 시
RESEND_API_KEY=
RESEND_FROM="KCT <news@yourdomain.com>"

# Supabase (https://supabase.com) — 구독자 DB + Auth + Storage(무료)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 배포된 사이트 URL (메일 링크/메타데이터용)
NEXT_PUBLIC_SITE_URL=https://kctimag.vercel.app

# 관리자 모드 (비밀번호 + 세션 시크릿)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# 일일 수집 크론 보호 (Vercel Cron이 Authorization: Bearer <CRON_SECRET> 전송) — 임의 랜덤 문자열
CRON_SECRET=

# Claude CLI 실행 경로 (기본: claude). claude -p 헤드리스 사용, 별도 키 불필요.
CLAUDE_BIN=claude
# 파이프라인 LLM(기본 LLM_PROVIDER=claude) 설정.
# ⚠️ 대용량 큐레이션 생성은 기본 effort(high)면 thinking이 길어 멈춤 → effort=medium 권장.
# CLAUDE_MODEL=opus
# CLAUDE_EXTRA_ARGS=--effort medium    # claude -p 에 그대로 전달되는 추가 인자
# LLM_TIMEOUT_MS=1200000               # claude/codex 호출 타임아웃(ms). 대용량 생성 여유 20분.
# LLM_JSON_RETRIES=3                   # LLM JSON 파싱/검증 실패 시 재시도 횟수

# 폴백 LLM — claude -p 가 멈추는 환경 대안. LLM_PROVIDER=kimi 로 사용.
# Kimi(Moonshot, OpenAI 호환): https://platform.moonshot.ai
# KIMI_API_KEY=
# KIMI_MODEL=kimi-k2.7-code-highspeed  # 빠름+JSON 안정(기본). 대안: kimi-k2.6, moonshot-v1-128k
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MAX_TOKENS=16000                # k2.x는 추론 토큰을 써서 넉넉히
# 그 밖의 폴백: LLM_PROVIDER=gemini (GOOGLE_GENAI_API_KEY) / groq (GROQ_API_KEY)
